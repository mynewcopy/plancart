# ============================================================
# PlanCart — Telegram Bot + Wishlist Web App
# ============================================================
# Copy this file to .env and fill in the required values.

# ----- REQUIRED -----

# Your Telegram Bot token from @BotFather
BOT_TOKEN=your_bot_token_here

# Public base URL of your server.
# In production use ngrok, Railway, VPS URL, etc.
# IMPORTANT: Telegram Mini Apps require HTTPS!
# Example: https://abc123.ngrok-free.app
APP_URL=http://localhost:8080

# ----- OPTIONAL -----

# Web server host/port
HOST=0.0.0.0
PORT=8080

# Secret key for HMAC signing (auto-generated default is fine for dev)
SECRET_KEY=change-me-in-production-to-a-long-random-string

# Debug mode — enables dev user fallback auth and verbose logging
DEBUG=true

# Directory for uploads and SQLite database
DATA_DIR=./data
